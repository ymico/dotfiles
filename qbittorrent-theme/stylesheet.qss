/* ====================================================================
   Amethyst Pixel — qBittorrent Theme
   A dark violet & amethyst neon theme matching the pixel desktop rice
   ==================================================================== */

/* --- Global Widgets & Windows --- */
QWidget {
    background-color: #0e0a14;
    color: #c0caf5;
    border: none;
    font-family: inherit;
    selection-background-color: #3b2857;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #0e0a14;
    color: #c0caf5;
}

QWidget:disabled {
    color: #544b66;
    background-color: #0e0a14;
}

/* --- Menu Bar & Menus --- */
QMenuBar {
    background-color: #0e0a14;
    color: #c0caf5;
    border-bottom: 1px solid #2e2145;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #231835;
    color: #ffffff;
}

QMenu {
    background-color: #140e1d;
    color: #c0caf5;
    border: 1px solid #3d2b5c;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    background: transparent;
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3b2857;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #2e2145;
    margin: 4px 6px;
}

QMenu::icon {
    padding-left: 4px;
}

/* --- Toolbar --- */
QToolBar {
    background-color: #0e0a14;
    border-top: none;
    border-bottom: 1px solid #2e2145;
    spacing: 4px;
    padding: 3px 6px;
}

QToolBar::separator {
    width: 1px;
    background-color: #2e2145;
    margin: 4px 6px;
}

QToolButton {
    background: transparent;
    color: #c0caf5;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
    margin: 1px;
}

QToolButton:hover {
    background-color: #221834;
    border: 1px solid #3d2b5c;
    color: #ffffff;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #35214e;
    border: 1px solid #bb9af7;
    color: #ffffff;
}

/* --- Tree Views, Table Views, List Views --- */
QTreeView, QTableView, QListView {
    background-color: #120b18;
    alternate-background-color: #170f20;
    color: #c0caf5;
    border: 1px solid #2e2145;
    border-radius: 4px;
    gridline-color: #1d1428;
    outline: none;
}

QTreeView::item, QTableView::item, QListView::item {
    padding: 4px;
    min-height: 22px;
    border: none;
}

QTreeView::item:hover, QTableView::item:hover, QListView::item:hover {
    background-color: #221834;
    color: #ffffff;
}

QTreeView::item:selected, QTableView::item:selected, QListView::item:selected {
    background-color: #3b2857;
    color: #ffffff;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/uitheme/icons/branch-closed.svg);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/uitheme/icons/branch-open.svg);
}

/* --- Table Headers --- */
QHeaderView {
    background-color: #170f22;
    border: none;
}

QHeaderView::section {
    background-color: #170f22;
    color: #a496c6;
    padding: 5px 8px;
    border: none;
    border-right: 1px solid #2e2145;
    border-bottom: 2px solid #2e2145;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #231835;
    color: #ffffff;
}

QHeaderView::up-arrow {
    image: url(:/uitheme/icons/arrow-up.svg);
    padding-right: 4px;
}

QHeaderView::down-arrow {
    image: url(:/uitheme/icons/arrow-down.svg);
    padding-right: 4px;
}

/* --- Tabs --- */
QTabWidget::pane {
    background-color: #120b18;
    border: 1px solid #2e2145;
    border-radius: 0 0 4px 4px;
}

QTabBar::tab {
    background-color: #170f22;
    color: #8f82a7;
    border: 1px solid #2e2145;
    border-bottom: none;
    padding: 6px 14px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:hover:!selected {
    background-color: #221834;
    color: #c0caf5;
}

QTabBar::tab:selected {
    background-color: #120b18;
    color: #bb9af7;
    border-top: 2px solid #bb9af7;
}

/* --- Buttons --- */
QPushButton {
    background-color: #1b1328;
    color: #c0caf5;
    border: 1px solid #3d2b5c;
    border-radius: 4px;
    padding: 5px 14px;
    min-height: 20px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #271a3d;
    border-color: #bb9af7;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #382453;
    border-color: #7dcfff;
}

QPushButton:disabled {
    background-color: #120b18;
    border-color: #211830;
    color: #544b66;
}

QPushButton:default {
    border-color: #bb9af7;
    background-color: #271a3d;
}

/* --- Inputs & Spinboxes --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #120b18;
    color: #c0caf5;
    border: 1px solid #2e2145;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #3b2857;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #bb9af7;
    background-color: #160e1e;
}

/* --- Combo Boxes --- */
QComboBox {
    background-color: #1b1328;
    color: #c0caf5;
    border: 1px solid #3d2b5c;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 20px;
}

QComboBox:hover {
    background-color: #271a3d;
    border-color: #bb9af7;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #2e2145;
}

QComboBox::down-arrow {
    image: url(:/uitheme/icons/arrow-down.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #140e1d;
    color: #c0caf5;
    border: 1px solid #3d2b5c;
    selection-background-color: #3b2857;
    selection-color: #ffffff;
    padding: 4px;
}

/* --- Progress Bars --- */
QProgressBar {
    background-color: #170f22;
    border: 1px solid #2e2145;
    border-radius: 3px;
    text-align: center;
    color: #ffffff;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8a63c9, stop:1 #bb9af7);
    border-radius: 2px;
}

/* --- Scroll Bars --- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #2a1c3e;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #9d7cd8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #2a1c3e;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #9d7cd8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0px;
}

/* --- Checkboxes & Radio Buttons --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #c0caf5;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    image: url(:/uitheme/icons/checkbox-unchecked.svg);
}

QCheckBox::indicator:checked {
    image: url(:/uitheme/icons/checkbox-checked.svg);
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QRadioButton::indicator:unchecked {
    image: url(:/uitheme/icons/radio-unchecked.svg);
}

QRadioButton::indicator:checked {
    image: url(:/uitheme/icons/radio-checked.svg);
}

/* --- Group Box --- */
QGroupBox {
    border: 1px solid #2e2145;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 12px;
}

QGroupBox::title {
    color: #bb9af7;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    font-weight: bold;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #0e0a14;
    color: #8f82a7;
    border-top: 1px solid #2e2145;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #8f82a7;
}

/* --- Splitter --- */
QSplitter::handle {
    background-color: #1a1226;
}

QSplitter::handle:hover {
    background-color: #bb9af7;
}

/* --- Tooltips --- */
QToolTip {
    background-color: #1a1226;
    color: #c0caf5;
    border: 1px solid #3d2b5c;
    border-radius: 4px;
    padding: 4px;
}
